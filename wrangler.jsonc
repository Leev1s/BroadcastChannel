{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "broadcast-channel",
  // Astro's Cloudflare adapter rewrites this to dist/server/wrangler.json after build.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "blog.r3.net.eu.org/*",
      "zone_name": "r3.net.eu.org"
    }
  ],
  "cache": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
